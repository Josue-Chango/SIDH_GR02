digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Médico"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
sel [label="Seleccionar paciente, episodio y\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
op [label="¿Crear solicitud?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
merge_datos [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
datos [label="Seleccionar exámenes e\nindicaciones clínicas",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
result [label="Consultar resultados y mostrar\nestado, fecha y validador cuando\ncorresponda",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
catalogo [label="Consultar catálogo de exámenes",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
validar [label="Validar paciente, episodio,\nexámenes, solicitante y datos\nobligatorios",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
ok [label="¿Solicitud válida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Mostrar errores de la solicitud",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
crear [label="Guardar solicitud única, fecha,\nsolicitante y estado solicitada",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
lab [label="Dejar solicitud disponible al\nlaboratorio y registrar auditoría",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> sel [id="flow_5",xlabel="[sí]"];
sel -> op [id="flow_6",xlabel=""];
op -> result [id="flow_7",xlabel="[no]"];
result -> fin [id="flow_8",xlabel=""];
op -> catalogo [id="flow_9",xlabel="[sí]"];
catalogo -> merge_datos [id="flow_10",xlabel=""];
datos -> validar [id="flow_11",xlabel=""];
validar -> ok [id="flow_12",xlabel=""];
ok -> err [id="flow_13",xlabel="[no]"];
err -> merge_datos [id="flow_14",xlabel="",constraint=false];
ok -> crear [id="flow_15",xlabel="[sí]"];
crear -> lab [id="flow_16",xlabel=""];
lab -> fin [id="flow_17",xlabel=""];
merge_datos -> datos [id="flow_18",xlabel=""];
}