digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Personal autorizado de\nadmisión"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU10a\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
sel [label="Seleccionar registro temporal y\nrecopilar datos de identificación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
rev [label="Revisar evidencias de identidad y\nposibles duplicados",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Conciliación autorizada\ny fundamentada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU10a\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU10a\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
buscar [label="Buscar coincidencias de paciente y\npreservar atenciones del temporal",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
pend [label="Registrar motivo pendiente y\nconservar el identificador\ntemporal",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
vinc [label="Vincular identidad confirmada sin\nperder episodios, órdenes ni\nresultados",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="CU10a\nRegistrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
confirmar_final [label="CU10a\nMostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> sel [id="flow_5",xlabel="[sí]"];
sel -> buscar [id="flow_6",xlabel=""];
buscar -> rev [id="flow_7",xlabel=""];
rev -> ok [id="flow_8",xlabel=""];
ok -> pend [id="flow_9",xlabel="[no]"];
pend -> fin [id="flow_10",xlabel=""];
ok -> vinc [id="flow_11",xlabel="[sí]"];
vinc -> audit_final [id="flow_12",xlabel=""];
audit_final -> confirmar_final [id="flow_13",xlabel=""];
confirmar_final -> fin [id="flow_14",xlabel="",constraint=false];
}