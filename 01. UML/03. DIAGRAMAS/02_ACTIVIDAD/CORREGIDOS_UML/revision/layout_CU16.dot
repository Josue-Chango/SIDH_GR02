digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Farmacéutico"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_sel [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
sel [label="Seleccionar producto, ubicación y\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
op [label="¿Operación elegida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
mov [label="Capturar entrada, salida, ajuste o\ntransferencia con cantidad, motivo\ny referencia",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
lote [label="Registrar lote, caducidad o\nbloqueo conforme a la política",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
min [label="Definir nivel mínimo por producto\ny ubicación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
ver [label="Mostrar existencias disponibles,\nreservadas y no dispensables;\nlotes y alertas",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
merge_validar [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
validar [label="Validar campos, permiso\nespecífico, saldo y restricciones\ndel movimiento",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
ok [label="¿Operación válida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Mostrar errores sin alterar\nexistencias",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
tx [label="Guardar movimiento y saldos de\norigen y destino en transacción, o\nconfiguración elegida",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
eval [label="Evaluar existencias disponibles\nfrente al umbral configurado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
bajo [label="¿Umbral de alerta\nalcanzado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
alerta [label="Generar o actualizar alerta de\nstock visible al farmacéutico",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
normal [label="Mantener estado sin alerta de\nstock bajo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
merge_audit [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
audit [label="Registrar operación y responsable\nsin duplicar movimientos de\ndispensación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> merge_sel [id="flow_5",xlabel="[sí]"];
sel -> op [id="flow_6",xlabel=""];
op -> ver [id="flow_7",xlabel="[consultar]"];
ver -> fin [id="flow_8",xlabel=""];
op -> mov [id="flow_9",xlabel="[movimiento]"];
mov -> merge_validar [id="flow_10",xlabel=""];
op -> lote [id="flow_11",xlabel="[lote o caducidad]"];
lote -> merge_validar [id="flow_12",xlabel=""];
op -> min [id="flow_13",xlabel="[nivel mínimo]"];
min -> merge_validar [id="flow_14",xlabel=""];
validar -> ok [id="flow_15",xlabel=""];
ok -> err [id="flow_16",xlabel="[no]"];
err -> merge_sel [id="flow_17",xlabel="",constraint=false];
ok -> tx [id="flow_18",xlabel="[sí]"];
tx -> eval [id="flow_19",xlabel=""];
eval -> bajo [id="flow_20",xlabel=""];
bajo -> alerta [id="flow_21",xlabel="[sí]"];
bajo -> normal [id="flow_22",xlabel="[no]"];
alerta -> merge_audit [id="flow_23",xlabel=""];
normal -> merge_audit [id="flow_24",xlabel=""];
audit -> fin [id="flow_25",xlabel="",constraint=false];
merge_sel -> sel [id="flow_26",xlabel=""];
merge_validar -> validar [id="flow_27",xlabel=""];
merge_audit -> audit [id="flow_28",xlabel=""];
}