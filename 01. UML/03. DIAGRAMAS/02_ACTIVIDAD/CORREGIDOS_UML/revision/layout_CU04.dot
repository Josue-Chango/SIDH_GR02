digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Recepcionista / Responsable\nde admisión"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU04\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
merge_buscar [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
buscar [label="Buscar por identificador,\ndocumento o nombres",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
existe [label="¿Paciente existente\nseleccionado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
actualizar [label="¿Actualizar datos?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
merge_capt [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
capt [label="Capturar datos nuevos o cambios\ndemográficos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU04\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU04\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
matches [label="Mostrar coincidencias con datos\nmínimos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
consulta [label="Consultar datos e historial\nadministrativo autorizado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
validar [label="Validar campos, formatos, fechas e\nidentificadores sensibles",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Datos válidos?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Mostrar errores para su corrección",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
dup [label="Buscar posibles duplicados del\nregistro",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
coinc [label="¿Existen posibles\nduplicados?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
rev [label="Solicitar revisión fundamentada de\ncoincidencias mediante DA CU04a",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
nuevo [label="¿Alta nueva autorizada\ntras revisión?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
merge_id [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
id [label="Generar identificador hospitalario\núnico",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_save [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
save [label="Guardar alta o actualización,\nconservar identificador existente\ny auditar",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
alta [label="¿Es un registro nuevo?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> merge_buscar [id="flow_5",xlabel="[sí]"];
buscar -> matches [id="flow_6",xlabel=""];
matches -> existe [id="flow_7",xlabel=""];
existe -> consulta [id="flow_8",xlabel="[sí]"];
consulta -> actualizar [id="flow_9",xlabel=""];
actualizar -> merge_capt [id="flow_10",xlabel="[sí]"];
actualizar -> fin [id="flow_11",xlabel="[no]"];
existe -> merge_capt [id="flow_12",xlabel="[no]"];
capt -> validar [id="flow_13",xlabel=""];
validar -> ok [id="flow_14",xlabel=""];
ok -> err [id="flow_15",xlabel="[no]"];
err -> merge_capt [id="flow_16",xlabel="",constraint=false];
ok -> dup [id="flow_17",xlabel="[sí]"];
dup -> coinc [id="flow_18",xlabel=""];
coinc -> rev [id="flow_19",xlabel="[sí]"];
rev -> nuevo [id="flow_20",xlabel=""];
nuevo -> merge_buscar [id="flow_21",xlabel="[no]",constraint=false];
nuevo -> merge_id [id="flow_22",xlabel="[sí]"];
coinc -> alta [id="flow_23",xlabel="[no]"];
alta -> merge_id [id="flow_24",xlabel="[sí]",constraint=false];
alta -> merge_save [id="flow_25",xlabel="[no]",constraint=false];
id -> merge_save [id="flow_26",xlabel=""];
save -> fin [id="flow_27",xlabel=""];
merge_buscar -> buscar [id="flow_28",xlabel=""];
merge_capt -> capt [id="flow_29",xlabel=""];
merge_id -> id [id="flow_30",xlabel=""];
merge_save -> save [id="flow_31",xlabel=""];
}