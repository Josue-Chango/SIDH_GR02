digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Recepcionista"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU05\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
datos [label="Seleccionar paciente, profesional,\nespecialidad y operación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
turno [label="Elegir turno, motivo y cita\nanterior si se reprograma",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
seguir [label="¿Elegir otro turno?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU05\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU05\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
merge_agenda [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
agenda [label="Consultar agenda y disponibilidad\ndel periodo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
validar [label="Validar datos, estado de cita y\ndisponibilidad del nuevo turno",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Reserva válida y\nexclusiva?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
error [label="Informar conflicto y conservar la\ncita anterior",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
reservar [label="Confirmar reserva en transacción;\nliberar turno anterior solo si se\nreprograma",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
audit [label="Asignar o conservar identificador\nde cita; registrar estado e\nhistorial del cambio",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> datos [id="flow_5",xlabel="[sí]"];
datos -> merge_agenda [id="flow_6",xlabel=""];
agenda -> turno [id="flow_7",xlabel=""];
turno -> validar [id="flow_8",xlabel=""];
validar -> ok [id="flow_9",xlabel=""];
ok -> error [id="flow_10",xlabel="[no]"];
error -> seguir [id="flow_11",xlabel=""];
seguir -> merge_agenda [id="flow_12",xlabel="[sí]",constraint=false];
seguir -> fin [id="flow_13",xlabel="[no]"];
ok -> reservar [id="flow_14",xlabel="[sí]"];
reservar -> audit [id="flow_15",xlabel=""];
audit -> fin [id="flow_16",xlabel=""];
merge_agenda -> agenda [id="flow_17",xlabel=""];
}