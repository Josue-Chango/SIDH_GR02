digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Personal de quirófano"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_datos [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
datos [label="Registrar paciente, procedimiento,\nequipo, fecha, hora y recursos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
lista [label="Registrar lista preoperatoria y\nquién completa los controles",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
pend [label="Registrar pendientes y decisión\ndel equipo; mantener programación\npendiente o reprogramar",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
recup [label="Registrar recuperación y\ndisposición posterior del paciente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Médico"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
pre [label="¿Controles y autorización\ncompletos?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
cirugia [label="Registrar intervención, tiempos,\nparticipantes y observaciones",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_2 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_2 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
recursos [label="Comprobar disponibilidad de\nrecursos gestionados",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Recursos disponibles?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
conf [label="Informar conflicto y solicitar\nreprogramación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
program [label="Confirmar programación y registrar\nresponsable",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
cierre [label="Actualizar estado del\nprocedimiento y cerrar registro\nsegún protocolo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="Registrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
confirmar_final [label="Mostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
{rank=same;anchor_0;anchor_1;anchor_2;}
anchor_0 -> anchor_1 -> anchor_2 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> merge_datos [id="flow_5",xlabel="[sí]"];
datos -> recursos [id="flow_6",xlabel=""];
recursos -> ok [id="flow_7",xlabel=""];
ok -> conf [id="flow_8",xlabel="[no]"];
conf -> merge_datos [id="flow_9",xlabel="",constraint=false];
ok -> program [id="flow_10",xlabel="[sí]"];
program -> lista [id="flow_11",xlabel=""];
lista -> pre [id="flow_12",xlabel=""];
pre -> pend [id="flow_13",xlabel="[no]"];
pend -> fin [id="flow_14",xlabel=""];
pre -> cirugia [id="flow_15",xlabel="[sí]"];
cirugia -> recup [id="flow_16",xlabel=""];
recup -> cierre [id="flow_17",xlabel=""];
cierre -> audit_final [id="flow_18",xlabel=""];
audit_final -> confirmar_final [id="flow_19",xlabel=""];
confirmar_final -> fin [id="flow_20",xlabel="",constraint=false];
merge_datos -> datos [id="flow_21",xlabel=""];
}