digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Médico / Enfermero /\nAuditor según rol"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
buscar [label="Solicitar paciente y finalidad de\nconsulta",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
alcance [label="Verificar rol, relación\nasistencial o autorización de\nauditoría y datos permitidos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
ok [label="¿Acceso clínico\nautorizado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
no [label="Denegar y registrar el intento sin\nrevelar datos clínicos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
leer [label="Recuperar antecedentes,\ndiagnósticos, alergias, atenciones\ny resultados autorizados",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
mostrar [label="Mostrar datos mínimos y distinguir\nresultados pendientes de\ndefinitivos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
audit [label="Registrar usuario, finalidad,\npaciente, fecha y resultado del\nacceso",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> buscar [id="flow_5",xlabel="[sí]"];
buscar -> alcance [id="flow_6",xlabel=""];
alcance -> ok [id="flow_7",xlabel=""];
ok -> no [id="flow_8",xlabel="[no]"];
no -> fin [id="flow_9",xlabel=""];
ok -> leer [id="flow_10",xlabel="[sí]"];
leer -> mostrar [id="flow_11",xlabel=""];
mostrar -> audit [id="flow_12",xlabel=""];
audit -> fin [id="flow_13",xlabel=""];
}