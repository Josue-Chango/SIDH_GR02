digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Gestor de camas /\nResponsable de admisión\nsegún permiso"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU17\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
merge_ocup [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
ocup [label="Consultar ocupación e ingreso del\npaciente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
sel [label="Seleccionar asignación o traslado,\ndestino y motivo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU17\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU17\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
val [label="Comprobar disponibilidad operativa\ny restricciones institucionales",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Destino compatible y\ndisponible?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
espera [label="Informar falta de cama; conservar\nubicación actual o registrar\nespera",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
tx [label="Revalidar destino y actualizar\nocupaciones de origen y destino en\ntransacción",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
commit [label="¿Asignación confirmada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
conf [label="Revertir cambios e informar\nconflicto concurrente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
hist [label="Registrar origen, destino, motivo,\nfecha y responsable; conservar\nhistorial",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="CU17\nRegistrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
confirmar_final [label="CU17\nMostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> merge_ocup [id="flow_5",xlabel="[sí]"];
ocup -> sel [id="flow_6",xlabel=""];
sel -> val [id="flow_7",xlabel=""];
val -> ok [id="flow_8",xlabel=""];
ok -> espera [id="flow_9",xlabel="[no]"];
espera -> fin [id="flow_10",xlabel=""];
ok -> tx [id="flow_11",xlabel="[sí]"];
tx -> commit [id="flow_12",xlabel=""];
commit -> conf [id="flow_13",xlabel="[no]"];
conf -> merge_ocup [id="flow_14",xlabel="",constraint=false];
commit -> hist [id="flow_15",xlabel="[sí]"];
hist -> audit_final [id="flow_16",xlabel=""];
audit_final -> confirmar_final [id="flow_17",xlabel=""];
confirmar_final -> fin [id="flow_18",xlabel="",constraint=false];
merge_ocup -> ocup [id="flow_19",xlabel=""];
}