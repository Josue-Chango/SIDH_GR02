digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Farmacéutico"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
receta [label="Seleccionar paciente y\nprescripción autorizada",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
validar [label="Comprobar información de\nprescripción para dispensación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
valida [label="¿Prescripción válida para\ndispensar?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
confirmar [label="Confirmar cantidad y lote a\ndispensar",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
entrega [label="Entregar medicamento y registrar\nresponsable y fecha",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
rech [label="Registrar rechazo y solicitar\nrevisión al prescriptor sin\nentregar medicamento",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
merge_stock [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
stock [label="Consultar existencias dispensables\npor producto, ubicación y lote",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
disponible [label="¿Cantidad suficiente y\nlote vigente no\nbloqueado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8699999999999999];
falta [label="Informar faltante o bloqueo y\nconservar receta pendiente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
tx [label="Revalidar cantidad y lote; guardar\ndispensación y salida en una\ntransacción",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
commit [label="¿Transacción confirmada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
conflicto [label="Revertir operación completa e\ninformar conflicto de inventario",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="Registrar auditoría de\ndispensación y movimiento asociado\nsin duplicar la salida",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
confirmar_final [label="Mostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> receta [id="flow_5",xlabel="[sí]"];
receta -> validar [id="flow_6",xlabel=""];
validar -> valida [id="flow_7",xlabel=""];
valida -> rech [id="flow_8",xlabel="[no]"];
rech -> fin [id="flow_9",xlabel=""];
valida -> merge_stock [id="flow_10",xlabel="[sí]"];
stock -> disponible [id="flow_11",xlabel=""];
disponible -> falta [id="flow_12",xlabel="[no]"];
falta -> fin [id="flow_13",xlabel=""];
disponible -> confirmar [id="flow_14",xlabel="[sí]"];
confirmar -> tx [id="flow_15",xlabel=""];
tx -> commit [id="flow_16",xlabel=""];
commit -> conflicto [id="flow_17",xlabel="[no]"];
conflicto -> merge_stock [id="flow_18",xlabel="",constraint=false];
commit -> entrega [id="flow_19",xlabel="[sí]"];
entrega -> audit_final [id="flow_20",xlabel=""];
audit_final -> confirmar_final [id="flow_21",xlabel=""];
confirmar_final -> fin [id="flow_22",xlabel="",constraint=false];
merge_stock -> stock [id="flow_23",xlabel=""];
}