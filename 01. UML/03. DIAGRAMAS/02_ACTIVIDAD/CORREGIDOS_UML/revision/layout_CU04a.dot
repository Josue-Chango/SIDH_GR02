digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Personal expresamente\nautorizado"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU04a\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
revisar [label="Revisar identidad, evidencias y\nregistros potencialmente\nduplicados",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
decision [label="¿Decisión autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU04a\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU04a\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
fusion [label="Consolidar conforme al\nprocedimiento aprobado; mantener\nidentificadores vinculados e\nhistorial",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.9199999999999999];
distintos [label="Conservar registros separados y\njustificar la decisión",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
pendiente [label="Conservar caso pendiente de\nrevisión sin fusionar",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_registrar [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
registrar [label="Registrar evidencia, decisión,\nresponsable y fecha; conservar\natenciones y documentos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> revisar [id="flow_5",xlabel="[sí]"];
revisar -> decision [id="flow_6",xlabel=""];
decision -> fusion [id="flow_7",xlabel="[fusionar]"];
decision -> distintos [id="flow_8",xlabel="[personas distintas]"];
decision -> pendiente [id="flow_9",xlabel="[evidencia insuficiente]"];
fusion -> merge_registrar [id="flow_10",xlabel=""];
distintos -> merge_registrar [id="flow_11",xlabel=""];
pendiente -> merge_registrar [id="flow_12",xlabel=""];
registrar -> fin [id="flow_13",xlabel=""];
merge_registrar -> registrar [id="flow_14",xlabel=""];
}