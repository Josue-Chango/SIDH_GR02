digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Gestor de camas y\nhospitalización"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU17a\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
sel [label="Seleccionar cama, estado operativo\no egreso administrativo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
tipo [label="¿Registrar egreso?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
estado [label="Definir estado operativo aprobado\ny motivo del cambio",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU17a\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU17a\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
alta [label="Verificar alta médica, salida\nregistrada y documentación de\negreso",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
ok [label="¿Egreso autorizado y\ncompleto?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
pend [label="Mantener ocupación e informar\npendientes",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
egreso [label="Preparar egreso con fecha y\nresponsable sin confirmar todavía\nlos cambios",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
limpieza [label="Determinar el estado de limpieza o\npreparación que corresponda",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_validar [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
validar [label="Validar transición operativa y\nausencia de ocupaciones\nincompatibles",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
val [label="¿Transición permitida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Rechazar cambio y conservar estado\nactual",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
save [label="Guardar egreso, fin de ocupación y\nestado en transacción; disponer\ncama solo tras preparación\nrequerida",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.9199999999999999];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="CU17a\nRegistrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
confirmar_final [label="CU17a\nMostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> sel [id="flow_5",xlabel="[sí]"];
sel -> tipo [id="flow_6",xlabel=""];
tipo -> estado [id="flow_7",xlabel="[no]"];
estado -> merge_validar [id="flow_8",xlabel=""];
tipo -> alta [id="flow_9",xlabel="[sí]"];
alta -> ok [id="flow_10",xlabel=""];
ok -> pend [id="flow_11",xlabel="[no]"];
pend -> fin [id="flow_12",xlabel=""];
ok -> egreso [id="flow_13",xlabel="[sí]"];
egreso -> limpieza [id="flow_14",xlabel=""];
limpieza -> merge_validar [id="flow_15",xlabel=""];
validar -> val [id="flow_16",xlabel=""];
val -> err [id="flow_17",xlabel="[no]"];
err -> fin [id="flow_18",xlabel=""];
val -> save [id="flow_19",xlabel="[sí]"];
save -> audit_final [id="flow_20",xlabel=""];
audit_final -> confirmar_final [id="flow_21",xlabel=""];
confirmar_final -> fin [id="flow_22",xlabel="",constraint=false];
merge_validar -> validar [id="flow_23",xlabel=""];
}