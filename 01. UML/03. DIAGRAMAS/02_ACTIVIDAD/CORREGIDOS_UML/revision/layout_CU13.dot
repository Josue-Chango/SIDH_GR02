digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Médico"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_sol [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
sol [label="Solicitar estudio con paciente,\nepisodio e indicación clínica",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
consulta [label="Consultar informe e imágenes\nautorizados",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Profesional de imagenología"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
programar [label="Registrar programación y ejecución\ndel estudio con su estado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
informe [label="Elaborar informe radiológico en\nborrador",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
publicar [label="¿Informe validado por\nprofesional autorizado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
}
subgraph cluster_2 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_2 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
validar [label="Validar solicitud y datos\nobligatorios",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Solicitud válida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Mostrar datos pendientes de la\nsolicitud",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
vincular [label="Vincular imágenes y documentos al\nestudio en repositorio aprobado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
borrador [label="Conservar borrador sin publicarlo\ncomo definitivo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
definitivo [label="Guardar informe validado con\nautoría y publicar según permiso",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="Registrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
confirmar_final [label="Mostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
{rank=same;anchor_0;anchor_1;anchor_2;}
anchor_0 -> anchor_1 -> anchor_2 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> merge_sol [id="flow_5",xlabel="[sí]"];
sol -> validar [id="flow_6",xlabel=""];
validar -> ok [id="flow_7",xlabel=""];
ok -> err [id="flow_8",xlabel="[no]"];
err -> merge_sol [id="flow_9",xlabel="",constraint=false];
ok -> programar [id="flow_10",xlabel="[sí]"];
programar -> informe [id="flow_11",xlabel=""];
informe -> vincular [id="flow_12",xlabel=""];
vincular -> publicar [id="flow_13",xlabel=""];
publicar -> borrador [id="flow_14",xlabel="[no]"];
borrador -> fin [id="flow_15",xlabel=""];
publicar -> definitivo [id="flow_16",xlabel="[sí]"];
definitivo -> consulta [id="flow_17",xlabel=""];
consulta -> audit_final [id="flow_18",xlabel=""];
audit_final -> confirmar_final [id="flow_19",xlabel=""];
confirmar_final -> fin [id="flow_20",xlabel="",constraint=false];
merge_sol -> sol [id="flow_21",xlabel=""];
}