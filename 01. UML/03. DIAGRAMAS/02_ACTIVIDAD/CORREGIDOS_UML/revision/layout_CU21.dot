digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Cajero / Facturador según\npermiso"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU21\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
sel [label="Seleccionar cuenta y consultar\ncargos, pagos, ajustes y saldo",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
pagar [label="¿Registrar pago?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
merge_datos [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
datos [label="Registrar importe, fecha, medio y\ndocumento relacionado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU21\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU21\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
validar [label="Validar permiso de caja, datos y\nreglas del importe aplicables",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Pago válido?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Mostrar motivo de rechazo sin\naplicar el pago",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
tx [label="Guardar pago y actualizar saldo\npendiente de forma transaccional",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
commit [label="¿Registro confirmado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
fallo [label="Revertir pago y saldo; informar\nfallo sin emitir comprobante",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
comprob [label="Emitir comprobante del pago\nconfirmado, incluido pago parcial",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
saldo [label="Mostrar saldo actualizado y\nregistrar auditoría",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> sel [id="flow_5",xlabel="[sí]"];
sel -> pagar [id="flow_6",xlabel=""];
pagar -> fin [id="flow_7",xlabel="[no]"];
pagar -> merge_datos [id="flow_8",xlabel="[sí]"];
datos -> validar [id="flow_9",xlabel=""];
validar -> ok [id="flow_10",xlabel=""];
ok -> err [id="flow_11",xlabel="[no]"];
err -> merge_datos [id="flow_12",xlabel="",constraint=false];
ok -> tx [id="flow_13",xlabel="[sí]"];
tx -> commit [id="flow_14",xlabel=""];
commit -> fallo [id="flow_15",xlabel="[no]"];
fallo -> fin [id="flow_16",xlabel=""];
commit -> comprob [id="flow_17",xlabel="[sí]"];
comprob -> saldo [id="flow_18",xlabel=""];
saldo -> fin [id="flow_19",xlabel=""];
merge_datos -> datos [id="flow_20",xlabel=""];
}