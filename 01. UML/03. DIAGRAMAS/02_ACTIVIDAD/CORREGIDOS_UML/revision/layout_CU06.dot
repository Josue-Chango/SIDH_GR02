digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Responsable de admisión /\nGestor de camas"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
buscar [label="Buscar y seleccionar paciente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ingreso [label="¿Registrar nueva\nadmisión?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
merge_capt [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
capt [label="Registrar indicación, motivo,\nprofesional responsable y datos\ndel ingreso",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
datos [label="Consultar datos administrativos,\ncobertura registrada e historial\nautorizado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
validar [label="Comprobar paciente, campos\nobligatorios e indicación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Admisión completa?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Solicitar completar o corregir\ndatos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
crear [label="Crear admisión y asociar o abrir\nepisodio único del paciente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="Registrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
confirmar_final [label="Mostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> buscar [id="flow_5",xlabel="[sí]"];
buscar -> datos [id="flow_6",xlabel=""];
datos -> ingreso [id="flow_7",xlabel=""];
ingreso -> merge_capt [id="flow_8",xlabel="[sí]"];
ingreso -> fin [id="flow_9",xlabel="[no]"];
capt -> validar [id="flow_10",xlabel=""];
validar -> ok [id="flow_11",xlabel=""];
ok -> err [id="flow_12",xlabel="[no]"];
err -> merge_capt [id="flow_13",xlabel="",constraint=false];
ok -> crear [id="flow_14",xlabel="[sí]"];
crear -> audit_final [id="flow_15",xlabel=""];
audit_final -> confirmar_final [id="flow_16",xlabel=""];
confirmar_final -> fin [id="flow_17",xlabel="",constraint=false];
merge_capt -> capt [id="flow_18",xlabel=""];
}