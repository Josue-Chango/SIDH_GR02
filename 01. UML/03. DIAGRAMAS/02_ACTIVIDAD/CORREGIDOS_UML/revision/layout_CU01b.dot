digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Usuario del sistema"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
cerrar [label="Solicitar cierre de sesión",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
esperar [label="Esperar cierre solicitado o\nvencimiento de sesión",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
causa [label="¿Evento de cierre?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
expirar [label="Detectar expiración o inactividad\nmáxima configurada",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_invalidar [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
invalidar [label="Invalidar la sesión en el servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
audit [label="Registrar el cierre o expiración\nsegún política",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
login [label="Exigir nueva autenticación para\nfunciones protegidas",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> esperar [id="flow_0",xlabel=""];
esperar -> causa [id="flow_1",xlabel=""];
causa -> cerrar [id="flow_2",xlabel="[cierre solicitado]"];
causa -> expirar [id="flow_3",xlabel="[expiración o inactividad]"];
cerrar -> merge_invalidar [id="flow_4",xlabel=""];
expirar -> merge_invalidar [id="flow_5",xlabel=""];
invalidar -> audit [id="flow_6",xlabel=""];
audit -> login [id="flow_7",xlabel=""];
login -> fin [id="flow_8",xlabel=""];
merge_invalidar -> invalidar [id="flow_9",xlabel=""];
}