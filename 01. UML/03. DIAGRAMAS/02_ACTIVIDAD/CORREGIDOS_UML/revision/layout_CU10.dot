digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Admisión / Recepcionista"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="CU10\nSeleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
ingreso [label="Registrar ingreso con datos\ndisponibles",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ident [label="¿Identidad suficiente?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
}
subgraph cluster_1 { label="Médico / Enfermero según\ncompetencia"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
prioridad [label="Registrar prioridad según\nprotocolo aprobado por el hospital",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
merge_atender [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
atender [label="Registrar valoración, signos\nvitales, intervenciones, órdenes y\nobservaciones",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
disp [label="¿Existe disposición\nclínica definida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
destino [label="Registrar alta, hospitalización,\ntraslado o derivación según\ndecisión clínica",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
subgraph cluster_2 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_2 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="CU10\nVerificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="CU10\nDenegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
temp [label="Generar identificador temporal\ncontrolado y dejar conciliación\npendiente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
merge_episode [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
episode [label="Crear o asociar episodio de\nemergencia al identificador del\npaciente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
continuar [label="Guardar evolución y mantener la\natención abierta",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
validar [label="Comprobar datos obligatorios para\nel cierre y vínculos del destino",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Cierre documentado?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Indicar información clínica\npendiente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
cerrar [label="Cerrar atención de emergencia y\nconservar pendiente de identidad\nsi corresponde",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
audit_final [label="CU10\nRegistrar auditoría con usuario,\nfecha, objeto y resultado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
confirmar_final [label="CU10\nMostrar el resultado de la\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
{rank=same;anchor_0;anchor_1;anchor_2;}
anchor_0 -> anchor_1 -> anchor_2 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> ingreso [id="flow_5",xlabel="[sí]"];
ingreso -> ident [id="flow_6",xlabel=""];
ident -> temp [id="flow_7",xlabel="[no]"];
ident -> merge_episode [id="flow_8",xlabel="[sí]"];
temp -> merge_episode [id="flow_9",xlabel=""];
episode -> prioridad [id="flow_10",xlabel=""];
prioridad -> merge_atender [id="flow_11",xlabel=""];
atender -> disp [id="flow_12",xlabel=""];
disp -> continuar [id="flow_13",xlabel="[no]"];
continuar -> fin [id="flow_14",xlabel=""];
disp -> destino [id="flow_15",xlabel="[sí]"];
destino -> validar [id="flow_16",xlabel=""];
validar -> ok [id="flow_17",xlabel=""];
ok -> err [id="flow_18",xlabel="[no]"];
err -> merge_atender [id="flow_19",xlabel="",constraint=false];
ok -> cerrar [id="flow_20",xlabel="[sí]"];
cerrar -> audit_final [id="flow_21",xlabel=""];
audit_final -> confirmar_final [id="flow_22",xlabel=""];
confirmar_final -> fin [id="flow_23",xlabel="",constraint=false];
merge_episode -> episode [id="flow_24",xlabel=""];
merge_atender -> atender [id="flow_25",xlabel=""];
}