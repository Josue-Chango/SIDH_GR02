digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Administrador del sistema"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
pedir [label="Seleccionar la operación y su\ncontexto",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
select [label="Seleccionar catálogo, elemento y\noperación",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
consulta [label="¿Solo consultar?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
merge_editar [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
editar [label="Registrar, modificar o desactivar\nel elemento y su vigencia",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
autorizar [label="Verificar sesión, rol y permiso en\nel servidor",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
permiso [label="¿Operación autorizada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
denegado [label="Denegar la operación y registrar\nel intento sin secretos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin_denegado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
ver [label="Mostrar catálogo y vigencias",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
validar [label="Validar unicidad, campos, fechas y\nreferencias históricas",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Elemento válido?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
err [label="Mostrar errores sin guardar\ncambios",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
guardar [label="Guardar vigencia y conservar\nreferencias históricas",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
audit [label="Registrar cambio, responsable,\nfecha y valores anteriores y\nnuevos",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.74];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> pedir [id="flow_0",xlabel=""];
pedir -> autorizar [id="flow_1",xlabel=""];
autorizar -> permiso [id="flow_2",xlabel=""];
permiso -> denegado [id="flow_3",xlabel="[no]"];
denegado -> fin_denegado [id="flow_4",xlabel=""];
permiso -> select [id="flow_5",xlabel="[sí]"];
select -> consulta [id="flow_6",xlabel=""];
consulta -> ver [id="flow_7",xlabel="[sí]"];
ver -> fin [id="flow_8",xlabel=""];
consulta -> merge_editar [id="flow_9",xlabel="[no]"];
editar -> validar [id="flow_10",xlabel=""];
validar -> ok [id="flow_11",xlabel=""];
ok -> err [id="flow_12",xlabel="[no]"];
err -> merge_editar [id="flow_13",xlabel="",constraint=false];
ok -> guardar [id="flow_14",xlabel="[sí]"];
guardar -> audit [id="flow_15",xlabel=""];
audit -> fin [id="flow_16",xlabel="",constraint=false];
merge_editar -> editar [id="flow_17",xlabel=""];
}