digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Usuario del sistema"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
merge_cred [label="",shape=diamond,width=.22,height=.22,fixedsize=true];
cred [label="Ingresar usuario y credencial",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
reintento [label="¿Reintentar?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
fin_cancelado [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
subgraph cluster_1 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
ver [label="Validar formato, credenciales y\ncuenta activa no bloqueada",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
ok [label="¿Autenticación válida?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
error [label="Registrar intento fallido y\nmostrar error genérico",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
sesion [label="Crear sesión segura y cargar\npermisos vigentes",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
audit [label="Registrar autenticación exitosa",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
panel [label="Mostrar funciones permitidas",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;}
anchor_0 -> anchor_1 [style=invis,weight=100];
inicio -> merge_cred [id="flow_0",xlabel=""];
cred -> ver [id="flow_1",xlabel=""];
ver -> ok [id="flow_2",xlabel=""];
ok -> error [id="flow_3",xlabel="[no]"];
error -> reintento [id="flow_4",xlabel=""];
reintento -> merge_cred [id="flow_5",xlabel="[sí]",constraint=false];
reintento -> fin_cancelado [id="flow_6",xlabel="[no]"];
ok -> sesion [id="flow_7",xlabel="[sí]"];
sesion -> audit [id="flow_8",xlabel=""];
audit -> panel [id="flow_9",xlabel=""];
panel -> fin [id="flow_10",xlabel=""];
merge_cred -> cred [id="flow_11",xlabel=""];
}