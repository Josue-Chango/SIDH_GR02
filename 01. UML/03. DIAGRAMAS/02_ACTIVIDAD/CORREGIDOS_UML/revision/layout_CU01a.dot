digraph G { graph [rankdir=TB,splines=ortho,nodesep=0.45,ranksep=0.5,pad=0.12,newrank=true,compound=true,forcelabels=true,bgcolor="white"]; node [fontname="Arial",fontsize=11,color="#334155",penwidth=1.1]; edge [fontname="Arial",fontsize=9,arrowsize=0.65,color="#334155"];
subgraph cluster_0 { label="Usuario del sistema"; fontname="Arial"; fontsize=12; margin=25; anchor_0 [shape=point,width=0.01,height=0.01,label="",style=invis];
inicio [label="",shape=circle,width=.20,height=.20,fixedsize=true,style=filled,fillcolor="#0f172a"];
sol [label="Solicitar recuperación o\nrestablecimiento",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_1 { label="Personal autorizado de\nsoporte"; fontname="Arial"; fontsize=12; margin=25; anchor_1 [shape=point,width=0.01,height=0.01,label="",style=invis];
ident [label="Verificar identidad mediante el\nmecanismo aprobado",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
idok [label="¿Identidad verificada?",shape=diamond,style=filled,fillcolor="#fff7ed",width=2.55,height=0.8];
rest [label="Ejecutar el procedimiento\ncontrolado de restablecimiento",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
}
subgraph cluster_2 { label="Sistema SIGH"; fontname="Arial"; fontsize=12; margin=25; anchor_2 [shape=point,width=0.01,height=0.01,label="",style=invis];
rech [label="Registrar rechazo y mostrar\nrespuesta genérica",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
audit [label="Guardar credencial protegida y\nregistrar el evento",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
info [label="Informar resultado sin revelar la\ncontraseña existente",shape=box,style="rounded,filled",fillcolor="#eff6ff",width=2.9,height=0.57];
fin [label="",shape=doublecircle,width=.23,height=.23,fixedsize=true,style=filled,fillcolor="#0f172a"];
}
{rank=same;anchor_0;anchor_1;anchor_2;}
anchor_0 -> anchor_1 -> anchor_2 [style=invis,weight=100];
inicio -> sol [id="flow_0",xlabel=""];
sol -> ident [id="flow_1",xlabel=""];
ident -> idok [id="flow_2",xlabel=""];
idok -> rest [id="flow_3",xlabel="[sí]"];
idok -> rech [id="flow_4",xlabel="[no]"];
rest -> audit [id="flow_5",xlabel=""];
audit -> info [id="flow_6",xlabel=""];
info -> fin [id="flow_7",xlabel=""];
rech -> fin [id="flow_8",xlabel=""];
}