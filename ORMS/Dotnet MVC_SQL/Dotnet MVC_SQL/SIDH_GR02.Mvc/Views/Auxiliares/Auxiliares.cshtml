@model AuxiliaresVista
@{ var f0 = Model.Form; }
<h1>@Model.Titulo</h1>
<p>Los códigos se ingresan explícitamente. No se pueden eliminar registros con dependencias.</p>
<h2>@(f0 == null ? "Nuevo registro" : "Editar registro")</h2>
<form action="@Url.Content(Model.Ruta)" method="post" class="editor">
    @Html.AntiForgeryToken()
    <input type="hidden" name="accion" value="@(f0 == null ? "crear" : "actualizar")">
    @if (Model.EsCargo)
    {
        <label>Departamento *
            @if (f0 == null)
            {
                <select name="dep" required>
                    <option value="">Seleccione</option>
                    @foreach (var d in Model.Departamentos)
                    {
                        <option value="@d.Id">@d.Id · @d.Descripcion</option>
                    }
                </select>
            }
            else
            {
                <input name="dep" value="@f0.Dep" readonly>
            }
        </label>
    }
    <label>Código *<input name="id" maxlength="@Model.MaxCodigo" value="@f0?.Codigo" readonly="@(f0 != null)" required></label>
    <label>Descripción *<input name="descripcion" type="text" maxlength="50" value="@f0?.Descripcion" required></label>
    <div class="acciones"><button>Guardar</button><a href="@Url.Content(Model.Ruta)">Nuevo / cancelar edición</a></div>
</form>

<h2>Registros</h2>
<div class="tabla">
    <table>
        <thead><tr>@if (Model.EsCargo) { <th>Departamento</th> }<th>Código</th><th>Descripción</th><th>Acciones</th></tr></thead>
        <tbody>
            @foreach (var f in Model.Filas)
            {
                <tr>
                    @if (Model.EsCargo) { <td>@f.Dep</td> }
                    <td>@f.Codigo</td>
                    <td>@f.Descripcion</td>
                    <td>
                        <a href="@Url.Con(Model.Ruta, ("accion", "editar"), ("id", f.Codigo), ("dep", f.Dep))">Editar</a>
                        <form action="@Url.Content(Model.Ruta)" method="post" class="enlinea" onsubmit="return confirm('¿Eliminar este registro auxiliar?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accion" value="eliminar">
                            <input type="hidden" name="id" value="@f.Codigo">
                            @if (Model.EsCargo) { <input type="hidden" name="dep" value="@f.Dep"> }
                            <button class="secundario">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@await Html.PartialAsync("_Paginacion", (Model.Ruta, Model.Pagina, Model.Filas.Count, (string?)null))
