    <parameter name="EMPLEADO" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <query language="sql"><![CDATA[SELECT PEFAM_PAREN, PEFAM_NOMBRE, PEFAM_FECNAC FROM PEFAM_FAMIL WHERE PEPER_CODIGO = $P{EMPLEADO} ORDER BY PEFAM_CODIGO]]></query>
