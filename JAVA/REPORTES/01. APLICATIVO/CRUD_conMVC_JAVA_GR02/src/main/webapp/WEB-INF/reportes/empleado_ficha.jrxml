<parameter name="ACADEMICOS_REPORTE" class="net.sf.jasperreports.engine.JasperReport"></parameter>
<parameter name="FAMILIARES_REPORTE" class="net.sf.jasperreports.engine.JasperReport"></parameter>
<query language="sql"><![CDATA[SELECT p.PEPER_CODIGO, p.PEPER_APELLI, p.PEPER_NOMBRE, p.PEPER_FECNAC,
g.PEGEN_DESCRI, e.PEESC_DESCRI, p.PEPER_PESO, p.PEPER_TIPSANG
FROM peper_perso p
LEFT JOIN PEGEN_GENERO g ON g.PEGEN_CODIGO = p.PEGEN_CODIGO
LEFT JOIN PEESC_ESTCIV e ON e.PEESC_CODIGO = p.PEESC_CODIGO WHERE p.PEPER_CODIGO = $P{EMPLEADO}]]></query>
<field name="PEPER_CODIGO" class="java.lang.String"/>
<field name="PEPER_APELLI" class="java.lang.String"/>
<field name="PEPER_NOMBRE" class="java.lang.String"/>
<field name="PEGEN_DESCRI" class="java.lang.String"/>
<field name="PEESC_DESCRI" class="java.lang.String"/>
<field name="PEPER_TIPSANG" class="java.lang.String"/>
<field name="PEPER_FECNAC" class="java.sql.Date"/>
<field name="PEPER_PESO" class="java.math.BigDecimal"/>
