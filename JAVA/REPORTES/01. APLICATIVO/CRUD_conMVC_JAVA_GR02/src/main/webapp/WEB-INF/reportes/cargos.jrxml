<element kind="staticText" uuid="183d939f-7dae-46ae-a446-6b646389825e" x="12" y="7" width="531" height="27" style="Base" fontSize="19.0" bold="true" forecolor="#FFFFFF" vTextAlign="Middle"><text><![CDATA[Reporte de cargos]]></text></element>
