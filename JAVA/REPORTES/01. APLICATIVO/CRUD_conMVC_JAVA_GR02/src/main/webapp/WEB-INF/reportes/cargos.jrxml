<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="cargos" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="a9482b21-8da7-4361-a01d-736b27f1f6b1">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="SIGH_GR02"/>
    <style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0" forecolor="#2B4354"/>
    <style name="Celda" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box leftPadding="8" rightPadding="8" topPadding="4" bottomPadding="4">
            <bottomPen lineWidth="0.45" lineColor="#DCE6EC"/>
        </box>
        <conditionalStyle backcolor="#F7FAFC">
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
        </conditionalStyle>
    </style>
    <style name="Cabecera" style="Base" fontSize="8.3" bold="true" mode="Opaque" forecolor="#17374D" backcolor="#F1F6F9" vTextAlign="Middle">
        <box leftPadding="8" rightPadding="8" topPadding="4" bottomPadding="4">
            <bottomPen lineWidth="0.45" lineColor="#BCCFD9"/>
        </box>
    </style>
    <style name="Seccion" style="Base" fontSize="9.5" bold="true" mode="Opaque" forecolor="#175D68" backcolor="#EAF4F5" vTextAlign="Middle">
        <box leftPadding="10" rightPadding="10" topPadding="4" bottomPadding="4">
            <leftPen lineWidth="3.0" lineColor="#137D88"/>
        </box>
    </style>
    <style name="Etiqueta" style="Base" fontSize="8.3" bold="true" mode="Opaque" forecolor="#526D7D" backcolor="#F3F7FA" vTextAlign="Middle">
        <box leftPadding="8" rightPadding="8" topPadding="4" bottomPadding="4">
            <bottomPen lineWidth="0.45" lineColor="#DCE6EC"/>
        </box>
    </style>
    <style name="Meta" style="Base" fontSize="8.0" forecolor="#657D8B" vTextAlign="Middle"/>
    <style name="Total" style="Base" fontSize="9.5" bold="true" forecolor="#17374D" vTextAlign="Middle">
        <box leftPadding="9" rightPadding="9" topPadding="4" bottomPadding="4"/>
    </style>
    <parameter name="USUARIO" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="DEPARTAMENTO" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <query language="sql"><![CDATA[SELECT c.PEDEP_CODIGO, d.PEDEP_DESCRI, c.PECAR_CODIGO, c.PECAR_DESCRI
FROM PECAR_CARGO c JOIN PEDEP_DEPAR d ON d.PEDEP_CODIGO = c.PEDEP_CODIGO
WHERE $P{DEPARTAMENTO} = '' OR c.PEDEP_CODIGO = $P{DEPARTAMENTO}
ORDER BY c.PEDEP_CODIGO, c.PECAR_CODIGO]]></query>
    <field name="PEDEP_CODIGO" class="java.lang.String"/>
    <field name="PEDEP_DESCRI" class="java.lang.String"/>
    <field name="PECAR_CODIGO" class="java.lang.String"/>
    <field name="PECAR_DESCRI" class="java.lang.String"/>
    <group name="Departamento" reprintHeaderOnEachPage="true" minHeightToStartNewPage="70">
        <expression><![CDATA[$F{PEDEP_CODIGO}]]></expression>
        <groupHeader>
            <band height="36">
                <element kind="textField" uuid="6dac8b3f-75ca-4a83-9eb2-505c65904a8a" x="0" y="5" width="555" height="27" style="Seccion" blankWhenNull="true" textAdjust="ScaleFont">
                    <expression><![CDATA[$F{PEDEP_CODIGO} + " - " + $F{PEDEP_DESCRI}]]></expression>
                </element>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="26">
                <element kind="textField" uuid="e32089cc-32c5-4009-b9fb-097bb9f66b5e" x="0" y="2" width="555" height="22" style="Meta" blankWhenNull="true" hTextAlign="Right" bold="true" fontSize="8.2" forecolor="#657D8B">
                    <expression><![CDATA["Cargos en el departamento: " + $V{Departamento_COUNT}]]></expression>
                </element>
            </band>
        </groupFooter>
    </group>
