<element kind="textField" uuid="cfd39b26-22b9-4265-880e-7cc206dc4776" x="335" y="55" width="208" height="17" style="Base" blankWhenNull="true" fontSize="8.0" forecolor="#FFFFFF" hTextAlign="Right"><expression><![CDATA["Fecha: " + java.time.ZonedDateTime.now(java.time.ZoneId.of("America/Guayaquil")).format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))]]></expression></element>
<element kind="textField" uuid="092b518c-b625-4e9d-9f76-869f2d6d91d1" x="0" y="82" width="555" height="22" style="Meta" blankWhenNull="true" bold="true"><expression><![CDATA[$P{DEPARTAMENTO}.isEmpty() ? "Todos los departamentos" : "Departamento seleccionado: " + $P{DEPARTAMENTO}]]></expression></element>
