<jasperReport name="cargos" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="a9482b21-8da7-4361-a01d-736b27f1f6b1">
<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SIGH_GR02"/>
<style name="Base" default="true" fontName="DejaVu Sans" fontSize="9.0"/>
<style name="Celda" style="Base" forecolor="#342D2D" vTextAlign="Middle"><box leftPadding="5" rightPadding="5" topPadding="3" bottomPadding="3"><bottomPen lineWidth="0.4" lineColor="#E1D8CF"/></box></style>
<style name="Cabecera" style="Celda" bold="true" mode="Opaque" forecolor="#4E0A0B" backcolor="#F1E7DC"/>
<style name="Seccion" style="Celda" fontSize="10.0" bold="true" mode="Opaque" forecolor="#FFFFFF" backcolor="#4E0A0B"/>
<style name="Meta" style="Base" forecolor="#6E5A51" fontSize="8.0" vTextAlign="Middle"/>
<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="DEPARTAMENTO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<query language="sql"><![CDATA[SELECT c.PEDEP_CODIGO, d.PEDEP_DESCRI, c.PECAR_CODIGO, c.PECAR_DESCRI
FROM PECAR_CARGO c JOIN PEDEP_DEPAR d ON d.PEDEP_CODIGO = c.PEDEP_CODIGO
WHERE $P{DEPARTAMENTO} = '' OR c.PEDEP_CODIGO = $P{DEPARTAMENTO}
ORDER BY c.PEDEP_CODIGO, c.PECAR_CODIGO]]></query>
<field name="PEDEP_CODIGO" class="java.lang.String"/>
<field name="PEDEP_DESCRI" class="java.lang.String"/>
<field name="PECAR_CODIGO" class="java.lang.String"/>
<field name="PECAR_DESCRI" class="java.lang.String"/>
<group name="Departamento" reprintHeaderOnEachPage="true" minHeightToStartNewPage="70">
<expression><![CDATA[$F{PEDEP_CODIGO}]]></expression>
<groupHeader><band height="30"><element kind="textField" uuid="6dac8b3f-75ca-4a83-9eb2-505c65904a8a" x="0" y="3" width="555" height="24" style="Seccion" blankWhenNull="true" textAdjust="ScaleFont"><expression><![CDATA[$F{PEDEP_CODIGO} + " - " + $F{PEDEP_DESCRI}]]></expression></element>
</band></groupHeader>
<groupFooter><band height="26"><element kind="textField" uuid="e32089cc-32c5-4009-b9fb-097bb9f66b5e" x="0" y="0" width="555" height="22" style="Meta" blankWhenNull="true" hTextAlign="Right" bold="true"><expression><![CDATA["Cargos en el departamento: " + $V{Departamento_COUNT}]]></expression></element>
</band></groupFooter></group>
