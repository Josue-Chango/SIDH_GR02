@using WebConMVCDotnet.Models
@{
    Layout = null;

    Departamento departamento = ViewBag.Departamento as Departamento ?? new Departamento();
    bool modoEdicion = ViewBag.ModoEdicion != null && (bool)ViewBag.ModoEdicion;
    string codigoOriginal = ViewBag.CodigoOriginal as string ?? string.Empty;
    List<Departamento> departamentos = ViewBag.Departamentos as List<Departamento> ?? new List<Departamento>();
    string mensajeExito = ViewBag.MensajeExito as string;
    string mensajeError = ViewBag.MensajeError as string;

    string codigoFormulario = departamento.CodigoDepart ?? string.Empty;
    string descriFormulario = departamento.DescriDeparta ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="color-scheme" content="only light" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Departamentos | SIGH</title>
    <link href="@Url.Content("~/Content/style_JCH.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <header class="encabezado">
        <div class="bienvenida">SUBSISTEMA DE PERSONAL</div>
        <div class="titulo">Gestión de Departamentos</div>
        <div class="texto">Tabla DEPARTAMENTO (PEDEP_DEPAR) &middot; SIGH</div>
    </header>

    <main class="crud-page">
        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alerta-exito" role="status">@mensajeExito</div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alerta-error" role="alert">@mensajeError</div>
        }

        <section class="crud-card" aria-labelledby="tituloFormulario">
            <h2 id="tituloFormulario">@(modoEdicion ? "Editar departamento" : "Nuevo departamento")</h2>

            <form action="@Url.Action("Guardar", "Departamento")" method="post" class="crud-form">
                @Html.AntiForgeryToken()
                @if (modoEdicion && !string.IsNullOrEmpty(codigoOriginal))
                {
                    <input type="hidden" name="codigoOriginal" value="@Html.Encode(codigoOriginal)" />
                }

                <div class="campo campo-codigo">
                    <label for="txtCodigo">Código</label>
                    <input type="text" id="txtCodigo" name="txtCodigo"
                           maxlength="3" minlength="3" required
                           value="@Html.Encode(codigoFormulario)"
                           placeholder="Ej.: VEN" />
                    <small class="ayuda-campo">3 caracteres (PEDEP_CODIGO es CHAR(3)).</small>
                </div>

                <div class="campo">
                    <label for="txtDescripcion">Descripción</label>
                    <input type="text" id="txtDescripcion" name="txtDescripcion"
                           maxlength="50" required
                           value="@Html.Encode(descriFormulario)"
                           placeholder="Ej.: VENTAS" />
                    <small class="ayuda-campo">Máximo 50 caracteres.</small>
                </div>

                <div class="form-acciones">
                    <button type="submit" class="btn-guardar">
                        @(modoEdicion ? "Guardar cambios" : "Guardar")
                    </button>
                    @if (modoEdicion)
                    {
                        <a class="btn-secundario" href="@Url.Action("Index", "Departamento")">Cancelar</a>
                    }
                </div>
            </form>
        </section>

        <section class="crud-card" aria-labelledby="tituloListado">
            <h2 id="tituloListado">Departamentos registrados</h2>

            <div class="tabla-contenedor">
                <table>
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (departamentos.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="tabla-vacia">No hay departamentos registrados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (Departamento dep in departamentos)
                            {
                                <tr>
                                    <td>@Html.Encode(dep.CodigoDepart)</td>
                                    <td>@Html.Encode(dep.DescriDeparta)</td>
                                    <td class="celda-acciones">
                                        <a class="btn-editar"
                                           href="@Url.Action("Editar", "Departamento", new { codigo = dep.CodigoDepart })">Editar</a>

                                        <form action="@Url.Action("Eliminar", "Departamento")" method="post" class="form-eliminar"
                                              onsubmit="return confirm('¿Eliminar este departamento?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="codigo" value="@Html.Encode(dep.CodigoDepart)" />
                                            <button type="submit" class="btn-eliminar">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <p class="volver-inicio"><a href="@Url.Action("Index", "Bienvenida")">&larr; Volver al inicio</a></p>
    </main>
</body>
</html>
