@using WebConMVCDotnet.Models
@{
    Layout = null;

    Cargo cargo = ViewBag.Cargo as Cargo ?? new Cargo();
    bool modoEdicion = ViewBag.ModoEdicion != null && (bool)ViewBag.ModoEdicion;
    string filtroDepartamento = ViewBag.FiltroDepartamento as string ?? string.Empty;
    List<Cargo> cargos = ViewBag.Cargos as List<Cargo> ?? new List<Cargo>();
    List<Departamento> departamentos = ViewBag.Departamentos as List<Departamento> ?? new List<Departamento>();
    bool sinDepartamentos = departamentos.Count == 0;
    string mensajeExito = ViewBag.MensajeExito as string;
    string mensajeError = ViewBag.MensajeError as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta name="color-scheme" content="only light" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cargos | SIGH</title>
    <link href="@Url.Content("~/Content/style_JCH.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <header class="encabezado">
        <div class="bienvenida">SUBSISTEMA DE PERSONAL</div>
        <div class="titulo">Gestión de Cargos</div>
        <div class="texto">Cargos y departamentos &middot; SIGH</div>
    </header>

    <main class="crud-page">
        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alerta-exito" role="status">@(mensajeExito)</div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alerta-error" role="alert">@(mensajeError)</div>
        }

        <section class="crud-card" aria-labelledby="tituloFormulario">
            <h2 id="tituloFormulario">@(modoEdicion ? "Editar cargo" : "Nuevo cargo")</h2>
            @if (sinDepartamentos)
            {
                <p>Primero <a href="@Url.Action("Index", "Departamento")">registre un departamento</a> para crear cargos.</p>
            }

            <form action="@Url.Action("Guardar", "Cargo")" method="post" class="crud-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="filtroDepartamento" value="@(filtroDepartamento)" />
                <input type="hidden" name="modo" value="@(modoEdicion ? "editar" : "nuevo")" />

                <div class="campo">
                    <label for="departamento">Departamento</label>
                    @if (modoEdicion)
                    {
                        <input type="hidden" name="departamento" value="@(cargo.CodigoDepart)" />
                        <input id="departamento" type="text" readonly="readonly"
                               value="@(cargo.CodigoDepart)" />
                    }
                    else
                    {
                        <select id="departamento" name="departamento" required="required" @Html.Raw(sinDepartamentos ? "disabled=\"disabled\"" : "")>
                            <option value="">Seleccione un departamento</option>
                            @foreach (Departamento dep in departamentos)
                            {
                                <option value="@(dep.CodigoDepart)"
                                        @(dep.CodigoDepart == cargo.CodigoDepart ? "selected=\"selected\"" : "")>
                                    @(dep.CodigoDepart) — @(dep.DescriDeparta)
                                </option>
                            }
                        </select>
                    }
                </div>

                <div class="campo campo-codigo">
                    <label for="codigo">Código del cargo</label>
                    <input type="text" id="codigo" name="codigo" minlength="3" maxlength="3" required="required"
                           value="@(cargo.CodigoCargo)"
                           @Html.Raw(modoEdicion ? "readonly=\"readonly\"" : "")
                           placeholder="Ej.: ADM" />
                    <small class="ayuda-campo">3 caracteres. El código puede repetirse en otro departamento.</small>
                </div>

                <div class="campo">
                    <label for="descripcion">Descripción</label>
                    <input type="text" id="descripcion" name="descripcion" maxlength="50" required="required"
                           value="@(cargo.DescriCargo)" placeholder="Ej.: Administrador" />
                    <small class="ayuda-campo">Máximo 50 caracteres.@(modoEdicion ? " El departamento y el código se conservan." : "")</small>
                </div>

                <div class="form-acciones">
                    <button type="submit" class="btn-guardar" @Html.Raw(sinDepartamentos ? "disabled=\"disabled\"" : "")>
                        @(modoEdicion ? "Guardar cambios" : "Guardar cargo")
                    </button>
                    @if (modoEdicion)
                    {
                        <a class="btn-secundario" href="@Url.Action("Index", "Cargo", new { filtroDepartamento = filtroDepartamento })">Cancelar</a>
                    }
                </div>
            </form>
        </section>

        <section class="crud-card" aria-labelledby="tituloListado">
            <h2 id="tituloListado">Cargos registrados</h2>

            <form action="@Url.Action("Index", "Cargo")" method="get" class="crud-form" role="search">
                <div class="campo">
                    <label for="filtroDepartamento">Buscar cargos por departamento</label>
                    <select id="filtroDepartamento" name="filtroDepartamento" onchange="this.form.submit()">
                        <option value="">Todos los departamentos</option>
                        @foreach (Departamento dep in departamentos)
                        {
                            <option value="@(dep.CodigoDepart)"
                                    @(dep.CodigoDepart == filtroDepartamento ? "selected=\"selected\"" : "")>
                                @(dep.CodigoDepart) — @(dep.DescriDeparta)
                            </option>
                        }
                    </select>
                </div>
                <div class="form-acciones"><button type="submit" class="btn-guardar">Consultar</button></div>
            </form>

            <p role="status">@cargos.Count cargo(s) encontrado(s).</p>

            <div class="tabla-contenedor">
                <table>
                    <thead>
                        <tr><th>Departamento</th><th>Código</th><th>Descripción</th><th>Acciones</th></tr>
                    </thead>
                    <tbody>
                        @if (cargos.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="tabla-vacia">
                                    @(filtroDepartamento.Length == 0
                                        ? "No hay cargos registrados."
                                        : "No hay cargos registrados en el departamento seleccionado.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (Cargo registro in cargos)
                            {
                                <tr>
                                    <td>@(registro.CodigoDepart) — @(registro.DescriDepart)</td>
                                    <td>@(registro.CodigoCargo)</td>
                                    <td>@(registro.DescriCargo)</td>
                                    <td class="celda-acciones">
                                        <a class="btn-editar"
                                           href="@Url.Action("Editar", "Cargo", new { departamento = registro.CodigoDepart, codigo = registro.CodigoCargo, filtroDepartamento = filtroDepartamento })">Editar</a>

                                        <form action="@Url.Action("Eliminar", "Cargo")" method="post" class="form-eliminar"
                                              onsubmit="return confirm('¿Eliminar este cargo?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="filtroDepartamento" value="@(filtroDepartamento)" />
                                            <input type="hidden" name="departamento" value="@(registro.CodigoDepart)" />
                                            <input type="hidden" name="codigo" value="@(registro.CodigoCargo)" />
                                            <button type="submit" class="btn-eliminar">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <p class="volver-inicio"><a href="@Url.Action("Index", "Bienvenida")">&larr; Volver al inicio</a></p>
    </main>
</body>
</html>
