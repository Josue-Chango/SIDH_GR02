@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión | SIGH</title>
    <link href="@Url.Content("~/Content/style_JCH.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/Scripts/login.js")" defer></script>
</head>
<body>
    <main class="login-page">
        <section class="login-card" aria-labelledby="tituloLogin">
            <div class="login-brand">SIGH</div>
            <h1 id="tituloLogin">Inicio de sesión</h1>
            <p class="login-subtitle">
                Subsistema de Seguridad &middot; Tabla <strong>USUARIO</strong>
            </p>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alerta-error" role="alert">@ViewBag.Error</div>
            }

            <form action="@Url.Action("Index", "Account")" method="post"
                  onsubmit="return validarLogin();" autocomplete="on">
                <label for="identificacion">Código de usuario</label>
                <input type="text" id="identificacion" name="txtIdentificacion"
                       maxlength="50" required autofocus
                       placeholder="Ej.: P000000001"
                       autocomplete="username"
                       value="@Request.Form["txtIdentificacion"]" />

                <label for="password">Contraseña</label>
                <input type="password" id="password" name="txtPassword"
                       maxlength="16" required
                       placeholder="Ingrese su contraseña"
                       autocomplete="current-password" />

                <button type="submit" class="btn-login">Ingresar</button>
            </form>

            <p class="login-hint">
                Ingrese con el código de persona (PEPER_CODIGO) registrado en la
                tabla <strong>USUARIO</strong> y su contraseña.
            </p>
        </section>
    </main>
</body>
</html>
